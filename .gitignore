# ==========================================
# 1. FRONTEND: admin (React + Vite + Tailwind)
# ==========================================
admin/node_modules/
admin/dist/
admin/dist-ssr/
admin/.cache/
admin/.vite/
admin/*.tsbuildinfo
admin/.eslintcache

# Variables de entorno del Frontend
admin/.env
admin/.env.*
!admin/.env.example
!admin/.env.*.example

# ==========================================
# 2. BACKEND: apiGeneralMercosur (Node + Express + PostgreSQL + Multer)
# ==========================================
apiGeneralMercosur/node_modules/

# Archivos subidos por los usuarios / temporales de Multer
apiGeneralMercosur/uploads/
apiGeneralMercosur/upload/
apiGeneralMercosur/tmp/
apiGeneralMercosur/temp/

# Archivos procesados o generados en la API (archiver / sheetjs / dumps SQL)
apiGeneralMercosur/*.zip
apiGeneralMercosur/*.xlsx
apiGeneralMercosur/*.csv
apiGeneralMercosur/*.sql
apiGeneralMercosur/*.dump

# Variables de entorno de la API (dotenv)
apiGeneralMercosur/.env
apiGeneralMercosur/.env.*
!apiGeneralMercosur/.env.example
!apiGeneralMercosur/.env.*.example

# ==========================================
# 3. GLOBAL: Reglas comunes, Sistema Operativo e IDEs
# ==========================================
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Archivos de Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Configuración de Editores / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?